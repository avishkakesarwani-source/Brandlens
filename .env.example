# =================================================================
# BrandLens Enterprise Configuration & Secrets
# Team NovaTech — TechCircuit Round 2
# =================================================================

# Server Port (Default: 5000)
PORT=5000

# MongoDB Database Connection String
# Example for MongoDB Atlas Cloud:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/brandlens?retryWrites=true&w=majority
# Example for Local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/brandlens
# NOTE: If omitted, BrandLens automatically falls back to its Resilient In-Memory Database!
MONGODB_URI=

# Google Gemini API Key for Contextual Deep Claims Analysis
GEMINI_API_KEY=
